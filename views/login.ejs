


<link rel="stylesheet" href="/bootstrap-5.0.2-dist/css/bootstrap.min.css">
    <style>
        body{
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }
        .login-box{
            direction: rtl;
        }
    </style>
<body class="login-page bg-body-secondary app-loaded">
    <div class="login-box" style="width: 350px;">
      <div class="errors"> <% if(typeof  errors!= "undefined"){ %>
       <% errors.forEach(element => { %>
       <p> <%= element.msg %> </p>
      <% }); }%>
      </div>
      <div class="login-logo">
   
      </div>
      <!-- /.login-logo -->
      <div class="card">
        <div class="card-body login-card-body">
          <p class="login-box-msg">ورود  </p>
          <form action="/login" method="post">
            <div class="input-group mb-3">
              <input  name="email" type="email" class="form-control" placeholder="ایمیل">
            </div>
            <div class="input-group mb-3">
              <input name="password" type="password" class="form-control" placeholder="پسورد">
            </div>
            <!--begin::Row-->
            <div class="row">
              <div class="col-8">
               
              </div>
              <!-- /.col -->
              <div class="col-4">
                <div class="d-grid gap-2">
                  <button type="submit" class="btn btn-primary"> ورود   </button>
                </div>
              </div>
              <!-- /.col -->
            </div>
            <!--end::Row-->
          </form>
          <div class="social-auth-links text-center mb-3 d-grid gap-2">
            <p>- یا -</p>
            <a href="#" class="btn btn-primary" style="background-color: rgba(0, 85, 255, 0.381);">
              <i style="color: black;" class="bi bi-facebook me-2"> ورود توسط فیسبوک</i>
            </a>
            <a href="#" class="btn btn-danger" style="background-color: rgba(255, 0, 144, 0.221);">
              <i style="color: black;" class="bi bi-google me-2"> ورود توسط گوگل</i>
            </a>
          </div>
          <!-- /.social-auth-links -->
         
          <p class="mb-0">
            <a style="text-decoration: none;" href="/" class="text-center"> قبلن ثبت نام نکرده ام </a>
          </p>
        </div>
        <!-- /.login-card-body -->
      </div>
    </div>

    
      <script src="/bootstrap-5.0.2-dist/js/bootstrap.bundle.min.js"></script>
   
  <script>
    const errors = document.querySelector('.errors')
    setInterval(() => {
      if(errors){
        errors.style.display = 'none'
      }
    }, 2000);
  </script>
  

</body>