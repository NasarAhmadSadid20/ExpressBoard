<!DOCTYPE html>
<html lang="fa">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ایجاد و نمایش پست</title>
    <style>
        body {
            font-family: 'Vazir', sans-serif;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: auto;
            background: linear-gradient(85deg pink , white);
        }
        
        .main2{
          width: 900px;
          padding: 20px;
          margin-left: 250px;
          position: absolute;
          right: 0;
          top: 0;
          text-align: right;
          z-index: 5;
          backdrop-filter: blur(5px);
         
        }
        .post-form, .post-list {
            flex: 1;
            padding: 20px;
            /* background: white; */
        
        }
        .post-form {
            border-right: 3px solid #ddd;
            /* background: #fff; */
        }
        .post-form h2, .post-list h2 {
            color: #ffffff;
            text-align: center;
            font-size: 24px;
            margin-bottom: 15px;
            font-weight: bold;
        }
        form {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
        input, textarea {
            width: 90%;
            padding: 12px;
            border: 2px solid #ff0000;
            border-radius: 8px;
            font-size: 16px;
            transition: all 0.3s;
            /* background: #f8f9fa; */
        }
        input:focus, textarea:focus {
            border-color: #680000;
            outline: none;
            box-shadow: 0px 0px 10px rgba(24, 119, 242, 0.3);
            /* background: white; */
        }
        button {
            background: #610000;
            color: white;
            border: none;
            padding: 14px;
            font-size: 18px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s;
            font-weight: bold;
        }
        button:hover {
            background: #000000;
        }
        .post-list {
            overflow-y: auto;
            max-height: 450px;
        }
        .post-form{
          width: 500px;
          position: fixed;
          top: 20px;
          left: 50px;
          z-index: 5;
        }
        .post {
            /* background: #ffffff; */
            padding: 18px;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.469);
            margin-bottom: 15px;
            transition: transform 0.3s ease-in-out;
        }
        .post:hover {
            transform: scale(1.02);
        }
        .post h3 {
            margin: 0 0 10px;
            color: #1877f2;
            font-size: 18px;
        }
        .post p {
            margin: 0;
            color: #555;
            font-size: 15px;
            line-height: 1.6;
        }
        .post img {
            width: 100%;
            max-height: 300px;
            object-fit: cover;
            border-radius: 10px;
            margin-top: 10px;
        }
    </style>
</head>
<body>
 
    
        <div class="post-form">
            <h2>ایجاد پست جدید</h2>
            <form method="post" action="/create-post">
                <textarea placeholder="متن پست" name="content" required></textarea>
                <input type="file" accept="image/*">
                <button type="submit">ثبت پست</button>
            </form>
        </div>
       

        </div>
        
    
     <div class="main2">
           <% user.posts.forEach(element => { %>
        <div class="post-list">
           
            <div class="post">
               <img src="">
                <p> <%=element.content %> </p>
               
            </div>
        </div>
         <% }); %>
</body>
</html>
