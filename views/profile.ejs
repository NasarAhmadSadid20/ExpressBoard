<!DOCTYPE html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>بلاگ ساده</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/js/all.min.js"
      crossorigin="anonymous"
    ></script>
    <style>
      .upload-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100px;
        height: 100px;
        border: 2px dashed #ccc;
        border-radius: 50%;
        cursor: pointer;
        font-size: 24px;
        color: #777;
        margin: 10px auto;
      }
      .upload-icon:hover {
        background-color: #f8f9fa;
      }
      #postImage {
        display: none;
      }
      .post-card {
        margin-bottom: 15px;
      }
      .bg-light{
        padding: 20px;
        display: flex;
        justify-content: space-around;
      }
      .main1{
        background-color: white;
        box-shadow: 0 0 5px rgba(0, 0, 0, 0.096);
        border-radius: 5px;
        padding: 20px;
        height: 70vh;
      }
      .main2{
        max-width: 500px;
      }

    </style>
  </head>
  <body class="bg-light">
    <div class="main1">
       <div class="container mt-5">
      <h1>سلام <%= user.name %> خشامدی </h1>
      <div  class="row">
        <!-- فرم اضافه کردن پست جدید -->
        <form action="/create-post" method="post">
          <div class="col-md-5">
            <h4>ایجاد پست جدید</h4>
            <textarea
              name="content"
              id="postContent"
              class="form-control mb-2"
              placeholder="متن پست"
            ></textarea>

            <label for="postImage" class="upload-icon">
              <i class="fa fa-camera"></i>
            </label>
            <input type="file" id="postImage" accept="image/*" />

            <button class="btn btn-primary w-100">افزودن پست</button>
          </div>
        </form>
      </div>
    </div>
    </div>

    <style>
      .main{
        background-color: red;
      }
    
 </style>






 <div class="main2">
  <% user.posts.forEach(element => { %>
 <div class="card post-card" id="">
      <img
        src=""
        class="card-img-top"
        style="max-height: 200px; object-fit: cover"
      />
          <div class="card-body">
        <p style="color: blue; background-color: rgba(0, 0, 0, 0.061); padding: 5px;" class="card-text"><%=user.email %></p>
        <p class="card-text"><%=element.content %></p>
        <button class="btn btn-warning btn-sm">ویرایش</button>
        <button class="btn btn-danger btn-sm">حذف</button>
      </div>

      
    </div>
    <% }); %>

 </div>
 
   

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
