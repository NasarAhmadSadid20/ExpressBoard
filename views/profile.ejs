<!DOCTYPE html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>بلاگ ساده</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/js/all.min.js"
      crossorigin="anonymous"
    ></script>
    <style>
      .upload-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100px;
        height: 100px;
        border: 2px dashed #ccc;
        border-radius: 50%;
        cursor: pointer;
        font-size: 24px;
        color: #777;
        margin: 10px auto;
      }
      .upload-icon:hover {
        background-color: #f8f9fa;
      }
      #postImage {
        display: none;
      }
      .post-card {
        margin-bottom: 15px;
      }
    </style>
  </head>
  <body class="bg-light">
    <div class="container mt-5">
      <div class="row">
        <!-- فرم اضافه کردن پست جدید -->
        <form action="/post-profile" method="post">
          <div class="col-md-4">
            <h4>ایجاد پست جدید</h4>
            <input
              name="title"
              type="text"
              id="postTitle"
              class="form-control mb-2"
              placeholder="عنوان پست"
            />
            <textarea
              name="content"
              id="postContent"
              class="form-control mb-2"
              placeholder="متن پست"
            ></textarea>

            <label for="postImage" class="upload-icon">
              <i class="fa fa-camera"></i>
            </label>
            <input type="file" id="postImage" accept="image/*" />

            <button class="btn btn-primary w-100">افزودن پست</button>
          </div>
        </form>
      </div>
    </div>
   

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
